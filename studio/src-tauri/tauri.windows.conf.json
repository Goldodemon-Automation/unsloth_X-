{
  "bundle": {
    "resources": {
      "../../install.ps1": "install.ps1",
      "../../release-backend": "backend-wheel"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "windows/sign-with-trusted-signing.ps1",
          "%1"
        ]
      }
    }
  }
}
